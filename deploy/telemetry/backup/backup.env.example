# Copy to /etc/tabula-telemetry/backup.env on the host, mode 600, owner root. Fill in on the host; nothing real belongs in git.
# The Storage Box sub-account (user and host) are given by Johan. The key and the restic password are created on the host.
STORAGEBOX_USER=
STORAGEBOX_HOST=
RESTIC_REPOSITORY_PATH=restic-telemetry
SSH_KEY=/root/.ssh/telemetry-backup
RESTIC_PASSWORD_FILE=/root/.restic-telemetry-pass
TELEMETRY_DATA=/srv/telemetry
# The checkout that holds deploy/telemetry/compose.yaml and the .env of the stack
COMPOSE_DIR=/opt/tabula-telemetry/deploy/telemetry
RESTORE_TEST_LOG=/var/log/tabula-telemetry-restore-tests.log
