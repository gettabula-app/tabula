{
  "uid": "tabula-fleet",
  "title": "Fleet overview",
  "description": "All workspaces. Operating data only; ids are workspace ids.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "tags": [
    "tabula",
    "telemetry"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Workspaces reporting (last 3 h)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "count(max by (workspace) (last_over_time(tabula_report_received_timestamp_seconds[3h])))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Silent for over 3 h (seen in 14 d)",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "count((time() - max by (workspace) (last_over_time(tabula_report_received_timestamp_seconds[14d]))) > 10800) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "Workspaces that reported within 14 days but not in the last 3 hours."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connections now (sum)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "sum(last_over_time(tabula_connections_now[3h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lowest disk free",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "min(last_over_time(tabula_disk_free_bytes[3h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Failed backups, last 24 h",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "sum(sum_over_time(tabula_backup_runs_hourly{result=\"failed\"}[24h])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "5xx responses, last 24 h",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "sum(sum_over_time(tabula_http_requests_hourly{status_class=\"5xx\"}[24h])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Workspaces",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "instant": true,
          "format": "table",
          "expr": "time() - max by (workspace) (last_over_time(tabula_report_received_timestamp_seconds[14d]))",
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "instant": true,
          "format": "table",
          "expr": "last_over_time(tabula_connections_now[3h])",
          "legendFormat": "",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "instant": true,
          "format": "table",
          "expr": "last_over_time(tabula_data_bytes[3h])",
          "legendFormat": "",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "instant": true,
          "format": "table",
          "expr": "last_over_time(tabula_process_rss_bytes[3h])",
          "legendFormat": "",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "workspace",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "renameByName": {
              "Value #A": "Seconds since last report",
              "Value #B": "Connections now",
              "Value #C": "Data bytes",
              "Value #D": "RSS bytes"
            }
          }
        }
      ],
      "description": "One row per workspace id. Ids only: no names or emails exist in the data."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Version adoption (workspaces per version)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "count by (app_version) (last_over_time(tabula_report_info[3h]))",
          "legendFormat": "{{app_version}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Connections peak by workspace",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "last_over_time(tabula_connections_peak[3h])",
          "legendFormat": "{{workspace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests per hour by status class",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum by (status_class) (sum_over_time(tabula_http_requests_hourly[1h]))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP duration p95 (all routes)",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "histogram_quantile(0.95, sum by (le) (sum_over_time(tabula_http_duration_ms_bucket[1h])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Data size by workspace",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "last_over_time(tabula_data_bytes[3h])",
          "legendFormat": "{{workspace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Disk free by workspace",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "last_over_time(tabula_disk_free_bytes[3h])",
          "legendFormat": "{{workspace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Collector: reports accepted and rejected",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1m",
          "expr": "increase(tabula_collector_reports_accepted_total[1h])",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1m",
          "expr": "sum by (reason) (increase(tabula_collector_reports_rejected_total[1h]))",
          "legendFormat": "rejected: {{reason}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
