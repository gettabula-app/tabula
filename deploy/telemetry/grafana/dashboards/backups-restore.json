{
  "uid": "tabula-backups",
  "title": "Backups and restore",
  "description": "Backup and restore health from the hourly reports.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "tags": [
    "tabula",
    "telemetry"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 34,
      "type": "stat",
      "title": "Backup runs, last 24 h",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "sum(sum_over_time(tabula_backup_runs_hourly[24h])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 35,
      "type": "stat",
      "title": "Failed backup runs, last 24 h",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "sum(sum_over_time(tabula_backup_runs_hourly{result=\"failed\"}[24h])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 36,
      "type": "stat",
      "title": "Restore runs, last 7 d",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "sum(sum_over_time(tabula_restore_runs_hourly[7d])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 37,
      "type": "stat",
      "title": "Failed restores, last 7 d",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "sum(sum_over_time(tabula_restore_runs_hourly{result=\"failed\"}[7d])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 38,
      "type": "table",
      "title": "Hours since the last successful backup, by workspace",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "instant": true,
          "format": "table",
          "expr": "(time() - max by (workspace) (tlast_over_time(tabula_backup_runs_hourly{result=\"ok\"}[14d]))) / 3600",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Hours"
            }
          }
        }
      ],
      "description": "Uses MetricsQL tlast_over_time (VictoriaMetrics)."
    },
    {
      "id": 39,
      "type": "table",
      "title": "Failed backups by workspace and error code, last 7 d",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "instant": true,
          "format": "table",
          "expr": "sum by (workspace, error_code) (sum_over_time(tabula_backup_runs_hourly{result=\"failed\"}[7d])) > 0",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Failures"
            }
          }
        }
      ]
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Backup runs per hour by result",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum by (result) (sum_over_time(tabula_backup_runs_hourly[1h]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Backup duration p50 and p95",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "histogram_quantile(0.5, sum by (le) (sum_over_time(tabula_backup_duration_ms_bucket[1h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "histogram_quantile(0.95, sum by (le) (sum_over_time(tabula_backup_duration_ms_bucket[1h])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Backup bytes per hour",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum by (result) (sum_over_time(tabula_backup_bytes_hourly[1h]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "Restore runs per hour by kind and result",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum by (kind, result) (sum_over_time(tabula_restore_runs_hourly[1h]))",
          "legendFormat": "{{kind}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
