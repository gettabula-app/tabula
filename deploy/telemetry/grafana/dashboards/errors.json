{
  "uid": "tabula-errors",
  "title": "Errors",
  "description": "Error codes and counts. The schema has no message text, so none can appear here.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "tags": [
    "tabula",
    "telemetry"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 57,
      "type": "timeseries",
      "title": "Error occurrences per hour by code",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "tabula-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "tabula-loki"
          },
          "expr": "sum by (code) (sum_over_time({job=\"tabula-telemetry\", kind=\"error\"} | json | unwrap count [1h]))",
          "legendFormat": "{{code}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 58,
      "type": "timeseries",
      "title": "Workspaces with errors per hour",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "tabula-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "tabula-loki"
          },
          "expr": "count by (workspace) (count_over_time({job=\"tabula-telemetry\", kind=\"error\"}[1h]))",
          "legendFormat": "{{workspace}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 59,
      "type": "timeseries",
      "title": "5xx responses per hour by workspace",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum by (workspace) (sum_over_time(tabula_http_requests_hourly{status_class=\"5xx\"}[1h]))",
          "legendFormat": "{{workspace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 60,
      "type": "timeseries",
      "title": "Failed backups and restores per hour",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum(sum_over_time(tabula_backup_runs_hourly{result=\"failed\"}[1h]))",
          "legendFormat": "backups",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum(sum_over_time(tabula_restore_runs_hourly{result=\"failed\"}[1h]))",
          "legendFormat": "restores",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 61,
      "type": "logs",
      "title": "Error entries (fingerprint, code, kind, status, top frame, count)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "tabula-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "tabula-loki"
          },
          "expr": "{job=\"tabula-telemetry\", kind=\"error\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 62,
      "type": "logs",
      "title": "Upgrade results",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "tabula-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "tabula-loki"
          },
          "expr": "{job=\"tabula-telemetry\", kind=\"event\", event=\"upgrade_result\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 63,
      "type": "logs",
      "title": "Daily top error codes",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "tabula-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "tabula-loki"
          },
          "expr": "{job=\"tabula-telemetry\", kind=\"event\", event=\"error_rate_day\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
