{
  "uid": "tabula-usage",
  "title": "Product usage counts",
  "description": "Counts only, never content. Product-analytics series are absent for workspaces whose owner turned that off.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "tags": [
    "tabula",
    "telemetry"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 44,
      "type": "timeseries",
      "title": "MCP calls per hour by tool (top 10)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "topk(10, sum by (tool) (sum_over_time(tabula_mcp_calls_hourly[1h])))",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
