{
  "uid": "tabula-workspace",
  "title": "Per-workspace health",
  "description": "Pick one or more workspace ids.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "tags": [
    "tabula",
    "telemetry"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "workspace",
        "label": "Workspace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tabula-vm"
        },
        "query": {
          "query": "label_values(tabula_report_info, workspace)",
          "refId": "ws"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 15,
      "type": "stat",
      "title": "Seconds since last report",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "time() - max(last_over_time(tabula_report_received_timestamp_seconds{workspace=~\"$workspace\"}[14d]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Version",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "count by (app_version) (last_over_time(tabula_report_info{workspace=~\"$workspace\"}[3h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "The label shows the version."
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Connections now",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "sum(last_over_time(tabula_connections_now{workspace=~\"$workspace\"}[3h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Connections peak",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "sum(last_over_time(tabula_connections_peak{workspace=~\"$workspace\"}[3h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Seconds since last activity",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "expr": "time() - max(last_over_time(tabula_last_activity_timestamp_seconds{workspace=~\"$workspace\"}[3h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Requests per hour by status class",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum by (status_class) (sum_over_time(tabula_http_requests_hourly{workspace=~\"$workspace\"}[1h]))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "HTTP duration p50 and p95",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "histogram_quantile(0.5, sum by (le) (sum_over_time(tabula_http_duration_ms_bucket{workspace=~\"$workspace\"}[1h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "histogram_quantile(0.95, sum by (le) (sum_over_time(tabula_http_duration_ms_bucket{workspace=~\"$workspace\"}[1h])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Sync save and load p95",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "histogram_quantile(0.95, sum by (le) (sum_over_time(tabula_sync_save_ms_bucket{workspace=~\"$workspace\"}[1h])))",
          "legendFormat": "save p95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "histogram_quantile(0.95, sum by (le) (sum_over_time(tabula_sync_load_ms_bucket{workspace=~\"$workspace\"}[1h])))",
          "legendFormat": "load p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Memory and event loop",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "last_over_time(tabula_process_rss_bytes{workspace=~\"$workspace\"}[3h])",
          "legendFormat": "RSS {{workspace}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "last_over_time(tabula_event_loop_lag_ms_p95{workspace=~\"$workspace\"}[3h])",
          "legendFormat": "loop lag p95 (ms) {{workspace}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "CPU seconds per hour",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum_over_time(tabula_cpu_seconds_hourly{workspace=~\"$workspace\"}[1h])",
          "legendFormat": "{{workspace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Data and disk free",
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "last_over_time(tabula_data_bytes{workspace=~\"$workspace\"}[3h])",
          "legendFormat": "data {{workspace}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "last_over_time(tabula_disk_free_bytes{workspace=~\"$workspace\"}[3h])",
          "legendFormat": "disk free {{workspace}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Entities",
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tabula-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tabula-vm"
          },
          "interval": "1h",
          "expr": "sum by (kind) (last_over_time(tabula_entities_total{workspace=~\"$workspace\"}[3h]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 27,
      "type": "logs",
      "title": "Error codes (counts and code names only)",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "tabula-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "tabula-loki"
          },
          "expr": "{job=\"tabula-telemetry\", kind=\"error\", workspace=~\"$workspace\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
