# Copy to .env on the host (mode 600). No real value belongs in this file or in git.

# Where the stack keeps its data on the host (subdirectories: state lake vm loki grafana). Interim host: /srv/telemetry
TELEMETRY_DATA=/srv/telemetry

# Addresses and ports the two doors are published on. Keep 127.0.0.1, or set the tunnel address (NetBird or WireGuard).
# Allowed: loopback, a NetBird address (100.64.0.0/10), or the one private address named in APPROVED_TUNNEL_ADDRESS.
# NEVER 0.0.0.0, a public address or an empty value: scripts/preflight.sh refuses it.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=8480
INGEST_BIND=127.0.0.1
INGEST_PORT=8481

# Grafana login (created on first start). Choose these on the host; leave empty here.
APPROVED_TUNNEL_ADDRESS=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# The URL operators type (through the tunnel).
GRAFANA_ROOT_URL=http://127.0.0.1:8480/

# Image tags are pinned in compose.yaml; pin digests at deploy time (see docs/telemetry-stack.md).
